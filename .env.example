# 飞书决策一致性引擎 - 环境变量模板
# 用法：cp .env.example .env，然后填实际值
# 04-ENGUIDE §9.1 镜像

# ─── 数据库 ───────────────────────────────────────────
# 与 docker-compose.yml 的 postgres 服务对齐
DATABASE_URL=postgresql+psycopg://memory:memory@localhost:5432/memory

# ─── Doubao（火山引擎） ───────────────────────────────
# 需在火山方舟创建 EP 后填入
DOUBAO_API_KEY=
DOUBAO_HEAVY_ENDPOINT_ID=ep-202604-xxxxxxxx       # Doubao 2.0
DOUBAO_LIGHT_ENDPOINT_ID=ep-202604-xxxxxxxx       # Doubao 1.6
DOUBAO_EMBEDDING_ENDPOINT_ID=ep-202604-xxxxxxxx   # Doubao Embedding v1
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# 单人 1w / 小组 3w；切换时网关读此变量调上限
LLM_TPM_TIER=single   # single | group

# ─── 飞书开放平台 ─────────────────────────────────────
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_VERIFICATION_TOKEN=
FEISHU_ENCRYPT_KEY=

# ─── 日志与运行 ──────────────────────────────────────
LOG_LEVEL=INFO              # DEBUG / INFO / WARNING / ERROR
ENVIRONMENT=development     # development / staging / production

# ─── 缓存（v1 进程内，v2 切 Redis） ──────────────────
CACHE_BACKEND=memory        # memory | redis
REDIS_URL=                  # 仅当 CACHE_BACKEND=redis 时填
